APP_NAME=GATE 2027 Prep API
ENVIRONMENT=development
DEBUG=false

# SQLite works out of the box. For PostgreSQL, use:
# DATABASE_URL=postgresql+asyncpg://gate:gate@postgres:5432/gate_prep
DATABASE_URL=sqlite+aiosqlite:///./gate_prep.db
# Neon supplies this automatically; migrations/bootstrap prefer the direct URL.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
# "auto" uses NullPool on Vercel/serverless and QueuePool elsewhere.
DATABASE_POOL_MODE=auto
SERVERLESS=false
# VERCEL=1 is supplied automatically by Vercel.
AUTO_BOOTSTRAP_ON_STARTUP=true
AUTO_CREATE_DB=true
SEED_DATA=true
AUTO_IMPORT_QUESTION_BANK=true
QUESTION_BANK_PATH=data/question_bank.json
SQL_ECHO=false

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Change this before any public deployment. Production refuses the built-in
# development value and sends the anonymous identity cookie only over HTTPS.
ANONYMOUS_IDENTITY_SECRET=gatepath-local-dev-secret-change-before-public-deployment
IDENTITY_COOKIE_SECURE=false
