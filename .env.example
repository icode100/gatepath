# Docker Compose PostgreSQL settings.
POSTGRES_DB=gatepath
POSTGRES_USER=gatepath
POSTGRES_PASSWORD=replace-with-a-strong-password

# Backend security settings shared by local and hosted environments.
ENVIRONMENT=development
ANONYMOUS_IDENTITY_SECRET=gatepath-local-dev-secret-change-before-public-deployment

# Optional: set a fully percent-encoded URI when the database password contains
# URL-reserved characters such as @, :, /, #, or %.
# DATABASE_URL=postgresql+asyncpg://gatepath:encoded-password@database:5432/gatepath
# DATABASE_URL_UNPOOLED=postgresql://gatepath:encoded-password@database:5432/gatepath

# Local Next.js and Docker Compose use BACKEND_INTERNAL_URL for their proxy.
# Docker Compose supplies it automatically.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Browser requests stay same-origin in every environment.
NEXT_PUBLIC_API_URL=/api/v1

# Firebase Web SDK identifiers. These values identify the public web app; they
# are not Admin credentials. Leave them empty to keep optional Firebase sign-in
# disabled during local development.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin and session-cookie settings. Vercel Production should set
# FIREBASE_AUTH_ENABLED=true and store the complete service-account object as
# one-line JSON in the Sensitive FIREBASE_SERVICE_ACCOUNT_JSON variable. Never
# prefix that secret with NEXT_PUBLIC_ or commit its value.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-service-account.json
FIREBASE_SESSION_COOKIE_NAME=gatepath_session
FIREBASE_CSRF_COOKIE_NAME=gatepath_csrf
FIREBASE_SESSION_MAX_AGE_SECONDS=432000
FIREBASE_RECENT_AUTH_SECONDS=300
# Keep false for low-latency per-request signature verification. Set true only
# when accepting the extra Firebase revocation lookup on every owned API call.
FIREBASE_CHECK_REVOKED=false

# Vercel production settings belong in the dashboard, not in a committed file.
# The Neon integration supplies DATABASE_URL. Keep startup writes disabled;
# run `cd backend` and then `python scripts/bootstrap_database.py` explicitly
# against the target DB.
# ENVIRONMENT=production
# AUTO_BOOTSTRAP_ON_STARTUP=false
# AUTO_CREATE_DB=false
# SEED_DATA=false
# AUTO_IMPORT_QUESTION_BANK=false
# QUESTION_BANK_PATH=data/question_bank.json
# IDENTITY_COOKIE_SECURE=true
# SQL_ECHO=false
# CORS_ORIGINS=https://gatepath.example.com
# NEXT_PUBLIC_SITE_URL=https://gatepath.example.com
