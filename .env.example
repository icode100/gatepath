# Docker Compose PostgreSQL settings.
POSTGRES_DB=gatepath
POSTGRES_USER=gatepath
POSTGRES_PASSWORD=replace-with-a-strong-password

# Backend security settings shared by local and hosted environments.
ENVIRONMENT=development
ANONYMOUS_IDENTITY_SECRET=gatepath-local-dev-secret-change-before-public-deployment

# Optional: set a fully percent-encoded URI when the database password contains
# URL-reserved characters such as @, :, /, #, or %.
# DATABASE_URL=postgresql+asyncpg://gatepath:encoded-password@database:5432/gatepath
# DATABASE_URL_UNPOOLED=postgresql://gatepath:encoded-password@database:5432/gatepath

# Local Next.js and Docker Compose use BACKEND_INTERNAL_URL for their proxy.
# Docker Compose supplies it automatically.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Browser requests stay same-origin in every environment.
NEXT_PUBLIC_API_URL=/api/v1

# Vercel production settings belong in the dashboard, not in a committed file.
# The Neon integration supplies DATABASE_URL. Keep startup writes disabled;
# run `cd backend` and then `python scripts/bootstrap_database.py` explicitly
# against the target DB.
# ENVIRONMENT=production
# AUTO_BOOTSTRAP_ON_STARTUP=false
# AUTO_CREATE_DB=false
# SEED_DATA=false
# AUTO_IMPORT_QUESTION_BANK=false
# QUESTION_BANK_PATH=data/question_bank.json
# IDENTITY_COOKIE_SECURE=true
# SQL_ECHO=false
# CORS_ORIGINS=https://gatepath.example.com
# NEXT_PUBLIC_SITE_URL=https://gatepath.example.com
